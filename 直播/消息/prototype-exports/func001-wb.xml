<whiteboard type="svg">
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600" width="1200" height="600">
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#666"/>
    </marker>
  </defs>
  <!-- Title -->
  <text x="600" y="35" font-family="Inter, sans-serif" font-size="20" font-weight="700" fill="#1A1A1A" text-anchor="middle">FUNC-001 发送语音消息 · 页面流程图</text>
  <!-- Screen 1 -->
  <rect x="30" y="60" width="180" height="320" rx="16" fill="#FFFFFF" stroke="#DDDDDD" stroke-width="2"/>
  <rect x="30" y="60" width="180" height="30" rx="16" fill="#F5F5F5"/>
  <text x="120" y="200" font-family="Inter, sans-serif" font-size="13" fill="#1A1A1A" text-anchor="middle">文字输入模式</text>
  <text x="120" y="220" font-family="Inter, sans-serif" font-size="11" fill="#666666" text-anchor="middle">（默认状态）</text>
  <rect x="55" y="330" width="130" height="26" rx="13" fill="#F5F5F5" stroke="#DDD" stroke-width="1"/>
  <text x="120" y="348" font-family="Inter, sans-serif" font-size="10" fill="#999">说点什么...</text>
  <circle cx="195" cy="343" r="14" fill="none" stroke="#222" stroke-width="2"/>
  <text x="195" y="348" font-family="Inter, sans-serif" font-size="10" fill="#222" text-anchor="middle">🎤</text>
  <!-- Arrow 1→2 -->
  <line x1="220" y1="210" x2="278" y2="210" stroke="#666" stroke-width="2" marker-end="url(#arrow)"/>
  <text x="249" y="198" font-family="Inter, sans-serif" font-size="10" fill="#7B2BFF" text-anchor="middle">点击🎤</text>
  <!-- Screen 2 -->
  <rect x="290" y="60" width="180" height="320" rx="16" fill="#FFFFFF" stroke="#7B2BFF" stroke-width="2"/>
  <rect x="290" y="60" width="180" height="30" rx="16" fill="#F5F5F5"/>
  <text x="380" y="200" font-family="Inter, sans-serif" font-size="13" fill="#1A1A1A" text-anchor="middle">语音消息模式</text>
  <rect x="310" y="290" width="70" height="24" rx="4" fill="#F0F0F0"/>
  <text x="345" y="306" font-family="Inter, sans-serif" font-size="9" fill="#666" text-anchor="middle">语音消息</text>
  <rect x="385" y="290" width="70" height="24" rx="4" fill="#F3E8FF"/>
  <text x="420" y="306" font-family="Inter, sans-serif" font-size="9" fill="#7B2BFF" text-anchor="middle">转文字</text>
  <rect x="315" y="330" width="130" height="32" rx="16" fill="#7B2BFF"/>
  <text x="380" y="351" font-family="Inter, sans-serif" font-size="11" fill="#FFF" text-anchor="middle">Hold to talk</text>
  <!-- Arrow 2→3 -->
  <line x1="480" y1="210" x2="538" y2="210" stroke="#666" stroke-width="2" marker-end="url(#arrow)"/>
  <text x="509" y="198" font-family="Inter, sans-serif" font-size="10" fill="#7B2BFF" text-anchor="middle">长按录音</text>
  <!-- Screen 3 -->
  <rect x="550" y="60" width="180" height="320" rx="16" fill="#FFFFFF" stroke="#FF3B5C" stroke-width="2"/>
  <rect x="550" y="60" width="180" height="30" rx="16" fill="#F5F5F5"/>
  <text x="640" y="190" font-family="Inter, sans-serif" font-size="13" fill="#1A1A1A" text-anchor="middle">录制中</text>
  <circle cx="640" cy="260" r="28" fill="#7B2BFF" opacity="0.15"/>
  <circle cx="640" cy="260" r="18" fill="#7B2BFF"/>
  <text x="640" y="265" font-family="Inter, sans-serif" font-size="12" fill="#FFF" text-anchor="middle">🎤</text>
  <text x="640" y="310" font-family="Inter, sans-serif" font-size="10" fill="#999" text-anchor="middle">0:03</text>
  <text x="640" y="330" font-family="Inter, sans-serif" font-size="9" fill="#999" text-anchor="middle">松开发送，上滑取消</text>
  <!-- Arrow 3→4 -->
  <line x1="740" y1="210" x2="798" y2="210" stroke="#666" stroke-width="2" marker-end="url(#arrow)"/>
  <text x="769" y="198" font-family="Inter, sans-serif" font-size="10" fill="#7B2BFF" text-anchor="middle">松开发送</text>
  <!-- Screen 4 -->
  <rect x="810" y="60" width="180" height="320" rx="16" fill="#FFFFFF" stroke="#00C853" stroke-width="2"/>
  <rect x="810" y="60" width="180" height="30" rx="16" fill="#F5F5F5"/>
  <text x="900" y="180" font-family="Inter, sans-serif" font-size="13" fill="#1A1A1A" text-anchor="middle">语音气泡（公屏）</text>
  <rect x="840" y="210" width="140" height="50" rx="12" fill="#F0F0F0"/>
  <text x="865" y="230" font-family="Inter, sans-serif" font-size="9" fill="#7B2BFF">用户B</text>
  <text x="865" y="248" font-family="Inter, sans-serif" font-size="10" fill="#222">▶ |||||||  0:05</text>
  <!-- Exception states section -->
  <text x="120" y="430" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="#FF3B5C">异常状态</text>
  <!-- Exception Screen 1 -->
  <rect x="30" y="450" width="160" height="130" rx="12" fill="#FFFFFF" stroke="#FF3B5C" stroke-width="1.5" stroke-dasharray="4,3"/>
  <text x="110" y="500" font-family="Inter, sans-serif" font-size="12" fill="#1A1A1A" text-anchor="middle">麦克风权限请求</text>
  <text x="110" y="520" font-family="Inter, sans-serif" font-size="9" fill="#666" text-anchor="middle">系统弹窗</text>
  <text x="110" y="540" font-family="Inter, sans-serif" font-size="9" fill="#666" text-anchor="middle">允许 / 拒绝</text>
  <text x="110" y="560" font-family="Inter, sans-serif" font-size="8" fill="#999" text-anchor="middle">触发: 首次点击麦克风</text>
  <!-- Exception Screen 2 -->
  <rect x="220" y="450" width="160" height="130" rx="12" fill="#FFFFFF" stroke="#FF3B5C" stroke-width="1.5" stroke-dasharray="4,3"/>
  <text x="300" y="500" font-family="Inter, sans-serif" font-size="12" fill="#1A1A1A" text-anchor="middle">禁言状态</text>
  <text x="300" y="520" font-family="Inter, sans-serif" font-size="9" fill="#666" text-anchor="middle">输入框置灰</text>
  <text x="300" y="540" font-family="Inter, sans-serif" font-size="9" fill="#666" text-anchor="middle">You are muted</text>
  <text x="300" y="560" font-family="Inter, sans-serif" font-size="8" fill="#999" text-anchor="middle">触发: 用户被禁言</text>
  <!-- Legend -->
  <rect x="1000" y="80" width="170" height="100" rx="8" fill="#F9F9F9" stroke="#EEE"/>
  <text x="1085" y="102" font-family="Inter, sans-serif" font-size="11" font-weight="600" fill="#333" text-anchor="middle">图例</text>
  <line x1="1020" y1="120" x2="1060" y2="120" stroke="#666" stroke-width="2" marker-end="url(#arrow)"/>
  <text x="1070" y="124" font-family="Inter, sans-serif" font-size="9" fill="#666">用户操作触发</text>
  <rect x="1020" y="140" width="40" height="20" rx="6" fill="none" stroke="#FF3B5C" stroke-width="1.5" stroke-dasharray="4,3"/>
  <text x="1070" y="154" font-family="Inter, sans-serif" font-size="9" fill="#666">异常/边界状态</text>
</svg>
</whiteboard>
