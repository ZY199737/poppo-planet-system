<h1>三、数据与接口</h1>
<h2>3.1 核心数据结构</h2>
<pre caption="核心数据模型" lang="typescript"><code>interface VoiceMessage {
  message_id: string;
  room_id: string;                  // 直播间 ID
  sender_id: string;                // 发送者用户 ID
  type: "voice";                    // 消息类型
  audio_url: string;                // 音频文件 CDN 地址
  duration: number;                 // 音频时长，单位秒，精度 0.1s
  file_size: number;                // 文件大小，单位字节
  format: "aac" | "opus";          // 音频编码格式
  created_at: string;               // ISO 8601 时间戳
}</code></pre>
<h2>3.2 接口定义</h2>
<pre caption="API-001 上传语音消息" lang="yaml"><code>api:
  id: API-001
  method: POST
  path: /api/v2/live/room/{room_id}/voice-message/upload
  auth: required
  description: "上传语音文件并发送语音消息到直播间公屏"

  request:
    body:
      file: { type: binary, required: true, description: "音频文件，AAC/Opus 格式" }
      duration: { type: float, required: true, description: "音频时长，单位秒" }

  response:
    success: { status: 200, body: { code: 0, data: { message_id: "string", audio_url: "string" } } }
    errors:
      - { status: 400, code: 30001, message: "音频时长不合法", client_action: "toast 提示" }
      - { status: 400, code: 30002, message: "音频文件过大", client_action: "toast 'File too large'" }
      - { status: 403, code: 30003, message: "用户被禁言", client_action: "toast 'You are muted'" }
      - { status: 403, code: 30004, message: "直播间不支持语音消息", client_action: "toast 并隐藏语音入口" }
      - { status: 429, code: 30005, message: "发送频率过高", client_action: "toast 'Please wait'" }
      - { status: 401, code: 10001, message: "未登录", client_action: "跳转登录页" }</code></pre>
<pre caption="API-002 语音转文字" lang="yaml"><code>api:
  id: API-002
  method: POST
  path: /api/v2/asr/recognize
  auth: required
  description: "语音转文字识别"

  request:
    body:
      file: { type: binary, required: true, description: "音频文件" }
      language: { type: string, required: false, default: "auto", description: "识别语言" }

  response:
    success: { status: 200, body: { code: 0, data: { text: "string", language: "string", confidence: 0.95 } } }
    errors:
      - { status: 400, code: 40001, message: "音频格式不支持", client_action: "toast 提示" }
      - { status: 400, code: 40002, message: "音频时长超限", client_action: "toast 提示" }
      - { status: 422, code: 40003, message: "无法识别语音内容", client_action: "toast 'No speech detected'" }
      - { status: 500, code: 40004, message: "识别服务异常", client_action: "toast 'Voice recognition failed'" }
      - { status: 401, code: 10001, message: "未登录", client_action: "跳转登录页" }</code></pre>
